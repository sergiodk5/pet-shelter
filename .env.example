# Copy to .env (gitignored) and adjust. Every value below is the default,
# so an empty or missing .env runs exactly like this.

# Port the API listens on.
PORT=8000

# development | production
NODE_ENV=development

# Comma-separated browser origins allowed to call this API, e.g.
# CORS_ORIGINS=http://localhost:5173,https://shelter.example
# Empty means no cross-origin browser access at all. Does not affect curl,
# server-to-server calls or the test suite.
CORS_ORIGINS=
