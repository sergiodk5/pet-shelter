# Copy to .env (gitignored) and adjust. Every value below except DATABASE_URL is
# the default, so a .env with only DATABASE_URL set runs exactly like this.

# Required. Postgres connection string. Matches compose.yml out of the box:
#   docker compose up -d
# The test suite does not use this - it runs Postgres in-process via pglite.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_shelter

# Port the API listens on.
PORT=8000

# development | production
NODE_ENV=development

# Comma-separated browser origins allowed to call this API, e.g.
# CORS_ORIGINS=http://localhost:5173,https://shelter.example
# Empty means no cross-origin browser access at all. Does not affect curl,
# server-to-server calls or the test suite.
CORS_ORIGINS=
