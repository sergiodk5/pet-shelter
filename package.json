{
  "name": "pet-shelter",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist && npx tsc -p tsconfig.build.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "dev": "nodemon",
    "lint": "oxlint --type-aware --deny-warnings src",
    "lint:fix": "oxlint --type-aware --fix src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate && test -z \"$(git status --porcelain migrations)\"",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "npm run build && node --env-file-if-exists=.env dist/seed.js",
    "db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "commit": "cz",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@faker-js/faker": "^10.6.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
